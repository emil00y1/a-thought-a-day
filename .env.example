# Postgres connection string (e.g. Neon, Supabase, or local)
DATABASE_URL=postgres://user:password@localhost:5432/thought

# Random string, at least 32 chars. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of the app
BETTER_AUTH_URL=http://localhost:3000

# Sign-in codes are emailed with Resend (resend.com). Leave empty in local dev
# and the code is printed in the terminal instead. Required in production.
RESEND_API_KEY=
# Sender address on a domain verified in Resend
EMAIL_FROM="A Thought a Day <hello@yourdomain.com>"

# Optional: Google login. Leave empty to hide the button.
# Redirect URI to register in Google Cloud: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
